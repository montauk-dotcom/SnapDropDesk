{
  "name": "snapdrop-desk",
  "productName": "SnapDrop Desk",
  "version": "0.1.0",
  "description": "Instant local file & text sharing between Mac, Windows, Linux, Android and iOS over Wi-Fi. No cloud.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "SnapDrop Desk contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "headless": "node src/cli.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.snapdrop.desk",
    "productName": "SnapDrop Desk",
    "files": ["src/**/*", "web/**/*", "assets/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "extendInfo": { "LSUIElement": true }
    },
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility", "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
