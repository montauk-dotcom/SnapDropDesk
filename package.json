{
  "name": "snapdrop-desk",
  "productName": "SnapDrop Desk",
  "version": "0.1.3",
  "description": "Instant local file & text sharing between Mac, Windows, Linux, Android and iOS over Wi-Fi. No cloud.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "SnapDrop Desk contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "headless": "node src/cli.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.snapdrop.desk",
    "productName": "SnapDrop Desk",
    "artifactName": "SnapDrop-Desk-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "web/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "SnapDrop Desk"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SnapDrop-Desk-${version}-win-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "SnapDrop Desk"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "SnapDrop Desk"
    },
    "afterPack": "build/afterPack.js"
  },
  "homepage": "https://github.com/montauk-dotcom/SnapDropDesk"
}
